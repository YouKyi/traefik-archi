# npm 12 refuse par defaut les recuperations "remote" (allow-remote=none). Un bug
# npm range a tort dans cette categorie les tarballs du registre des paquets a
# bundleDependencies, dont @tailwindcss/oxide-wasm32-wasi : Renovate echoue alors
# sur "npm install --package-lock-only" (EALLOWREMOTE) et laisse le lockfile
# desynchronise. On remet le defaut de npm 11. A retirer quand
# https://github.com/npm/cli/issues/9800 sera corrige.
allow-remote=all
